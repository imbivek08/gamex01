# ---- Server (server/.env) ----
DATABASE_URL="postgresql://auction:auction@localhost:5434/cricket_auction?schema=public"
PORT=4000
# Comma-separated list of allowed browser origins for Socket.IO / CORS
CLIENT_ORIGIN="http://localhost:3000"

# ---- Web (web/.env.local) ----
# Base URL of the Socket.IO / API server (browser connects directly)
NEXT_PUBLIC_SERVER_URL="http://localhost:4000"
